{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "speech model request parameters",
 "description": "parameters of a speech-to-text request; a pack serves the names its bucket declares in io.params (absent: default_declared)",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "max_new_tokens": {"type": "integer", "minimum": 1},
  "language": {"type": "string", "minLength": 1},
  "instruction": {"type": "string", "minLength": 1},
  "timestamps": {"type": "boolean"},
  "chunking": {"enum": ["none", "window"]}
 },
 "default_declared": ["max_new_tokens"]
}
